@startuml
!include style.iuml
autonumber
actor Staff
participant "SRS Console" as UI
participant "Backend API" as API
database "PostgreSQL" as DB
participant "Brevo" as BV
Staff -> UI : choose module, venue, date, slot
UI -> API : POST /api/bookings
activate API
API -> DB : BEGIN; read module, venue capacity, registered students
API -> DB : lock venue/date/slot
alt capacity < 1, no students, already booked,\nhall full or a student has a clash
  API -> DB : ROLLBACK
  API --> UI : 409 + reason
  UI --> Staff : error message
else ok
  group database transaction (continued)
    API -> DB : INSERT exam_bookings
    API -> DB : INSERT seat_reservations (seat numbers)
    API -> DB : COMMIT
  end
  API -> DB : INSERT email_outbox (one per student)
  API --> UI : 201 booking + students not enrolled at this venue
  UI --> Staff : booking shown in table and calendar
  API ->> BV : send queued e-mails (background)
  BV --> API : message id
  API -> DB : UPDATE email_outbox SET status = 'sent'
end
deactivate API
== Exam day: timer every 60 s ==
loop every minute
  API -> DB : sessions that ended (12:00 / 16:00)?
  opt a session has ended
    API -> DB : INSERT access_events (decision = 'signed_out')\nfor everyone let in during it
  end
end
@enduml
