@startuml
!pragma layout smetana
!include style.iuml
left to right direction
actor "Invigilator" as Inv
actor "Administrator" as Adm
actor "Student" as Stu
actor "Brevo\n<<e-mail service>>" as Brevo
Adm -|> Inv
rectangle "Smart Registration System" {
  usecase "Sign in / change password" as UC1
  usecase "Enrol student's face" as UC2
  usecase "Confirm consent" as UC2a
  usecase "Manage students\nand modules" as UC3
  usecase "Book, move or\ncancel an exam" as UC4
  usecase "E-mail students" as UC4a
  usecase "Monitor live dashboard" as UC5
  usecase "Override a denied entry" as UC6
  usecase "Export access log (CSV)" as UC7
  usecase "Manage venues\nand door units" as UC8
  usecase "Manage staff accounts" as UC9
  usecase "Verify identity at the door" as UC10
  usecase "Look up seat for\ncurrent session" as UC10a
}
Inv --> UC1
Inv --> UC2
Inv --> UC3
Inv --> UC4
Inv --> UC5
Inv --> UC7
Adm --> UC8
Adm --> UC9
Stu --> UC10
UC2 ..> UC2a : <<include>>
UC4 ..> UC4a : <<include>>
UC10 ..> UC10a : <<include>>
UC6 ..> UC5 : <<extend>>
UC4a --> Brevo
@enduml
