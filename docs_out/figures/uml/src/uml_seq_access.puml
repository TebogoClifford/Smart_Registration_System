@startuml
!include style.iuml
autonumber
actor Student
participant "Arduino\ndoor unit" as A
participant "PC door\nprogram" as PC
participant "FaceStore\n(local disk)" as FS
participant "Backend API" as API
database "PostgreSQL" as DB
== Every 2 minutes and at 12:00 / 16:00 ==
PC -> API : GET /api/devices/{id}/session
activate API
API -> DB : seats, already inside, session end
API --> PC : students[], alreadyInside[], endsAt
deactivate API
== A student walks up ==
Student -> A : stands 25-50 cm for 1 s
activate A
A -> PC : READY
activate PC
PC -> PC : detect face (YuNet)\nembed (SFace)
PC -> FS : best_match(embedding)
FS --> PC : (studentId, similarity)
alt similarity < 0.40
  PC -> A : D
  A --> Student : ACCESS DENIED (low tone)
else already inside this session
  PC -> A : A
  A --> Student : ALREADY INSIDE (two beeps)
else session ended
  PC -> A : D
  A --> Student : ACCESS DENIED (low tone)
else recognised
  PC -> A : G
  A --> Student : ACCESS GRANTED (two rising tones)
  note right of PC : PC window shows seat N + module,\nor "no exam seat in this session"
end
deactivate A
PC ->> API : POST /api/access-events\n{deviceId, decision, studentId, clientEventId}
activate API
API -> DB : INSERT access_events\n(duplicate clientEventId ignored)
API --> PC : 201 Created (or 200 duplicate)
deactivate API
deactivate PC
opt internet down
  PC -> PC : keep events in data/event_queue.json
  PC ->> API : later: POST /api/access-events/batch (max 100)
end
@enduml
