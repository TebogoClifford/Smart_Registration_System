' shared look for all SRS UML diagrams (TUT navy, white background)
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #1F4E8C
skinparam ArrowFontSize 12
skinparam ActorBorderColor #0B2F63
skinparam ActorBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #0B2F63
skinparam ParticipantBackgroundColor #EEF4FB
skinparam DatabaseBorderColor #0B2F63
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceLifeLineBorderColor #8AA4C8
skinparam SequenceBoxBorderColor #8AA4C8
skinparam SequenceGroupBorderColor #1F4E8C
skinparam SequenceGroupHeaderFontColor #0B2F63
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #C98A00
skinparam ActivityBorderColor #0B2F63
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityDiamondBorderColor #C98A00
skinparam ActivityDiamondBackgroundColor #FFF6E0
skinparam SwimlaneBorderColor #8AA4C8
skinparam SwimlaneTitleFontColor #0B2F63
skinparam SwimlaneTitleFontStyle bold
skinparam ClassBorderColor #0B2F63
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #EEF4FB
skinparam ClassAttributeIconSize 0
skinparam StateBorderColor #0B2F63
skinparam StateBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #0B2F63
skinparam UsecaseBackgroundColor #EEF4FB
skinparam RectangleBorderColor #0B2F63
skinparam NodeBorderColor #0B2F63
skinparam NodeBackgroundColor #EEF4FB
skinparam ArtifactBackgroundColor #FFFFFF
skinparam CloudBorderColor #0B2F63
skinparam PackageBorderColor #8AA4C8
