@startuml
!include style.iuml
!pragma useVerticalIf on
|Student|
start
:Walk up to the door unit;
|Arduino door unit|
repeat
  :Measure distance (HC-SR04, every 60 ms);
  if (distance?) then ([< 25 cm])
    :LCD "Too close / Step back";
  elseif () then ([> 50 cm])
    :LCD "Come closer";
  else ([25-50 cm])
    :LCD "Hold still" + progress bar;
  endif
repeat while (held in window for 1 s?) is ([no]) not ([yes])
:Beep; send READY over USB serial;
|PC door program|
:Capture webcam frame;
:Detect largest face (YuNet);
:Compute 128-number embedding (SFace);
:Compare with ALL faces stored on this PC;
if (best cosine similarity >= 0.40\nand same answer in 3 frames?) then ([no])
  :decision = denied\n"NOT RECOGNISED";
else ([yes])
  if (session over or student\nsigned out for this session?) then ([yes])
    :decision = ended\n"SESSION ENDED";
  elseif (already let in\nthis session?) then ([yes])
    :decision = already\n"ALREADY INSIDE";
  else ([no])
    :decision = granted\nshow seat N + module\nor "no exam seat in this session";
  endif
endif
fork
  :Send G / D / A to Arduino;
  |Arduino door unit|
  :Show result on LCD and beep;
  :Wait until student steps beyond 65 cm;
fork again
  |PC door program|
  :Add event to queue on disk;
  if (online?) then ([yes])
    :POST /api/access-events;
    |Backend|
    :Validate device key;
    :Store event (unique client_event_id);
    :Dashboard shows the event;
  else ([no])
    |PC door program|
    :Keep in queue; upload later in a batch;
  endif
end fork
|Student|
if (decision = granted?) then ([yes])
  :Enter the venue;
else ([no])
  :Show student card to invigilator\n(manual check, Override);
endif
stop
@enduml
