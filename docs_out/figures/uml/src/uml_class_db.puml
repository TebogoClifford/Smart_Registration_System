@startuml
!pragma layout smetana
!include style.iuml
hide circle
hide methods
skinparam linetype ortho
class Venue <<table venues>> {
  <<PK>> id : Int
  {field} name : VarChar(100)
  capacity : Int = 0
  created_at : Timestamp
}
class Device <<table devices>> {
  <<PK>> id : Int
  <<FK>> venue_id : Int
  {field} name : VarChar(100)
  {field} api_key : VarChar(64)
  {field} status : VarChar(20) = "inactive"
  last_seen : Timestamptz [0..1]
}
class Student <<table students>> {
  <<PK>> id : Int
  {field} student_number : VarChar(20)
  {field} name : VarChar(100)
  {field} email : VarChar(255) [0..1]
  {field} course_name : VarChar(100) [0..1]
  <<FK>> device_id : Int [0..1]
  {field} enrollment_status : VarChar(20) = "pending"
  enrollment_image : Bytes [0..1]
}
class AccessEvent <<table access_events>> {
  <<PK>> id : Int
  <<FK>> device_id : Int
  <<FK>> student_id : Int [0..1]
  {field} decision : VarChar(10)
  event_time : Timestamp
  {field} client_event_id : VarChar(64) [0..1]
}
class EventOverride <<table event_overrides>> {
  <<PK>> id : Int
  <<FK>> event_id : Int
  {field} invigilator_id : VarChar(255)
  reason : Text
}
class Module <<table modules>> {
  <<PK>> id : Int
  {field} code : VarChar(20) {unique}
  {field} name : VarChar(100)
}
class StudentModule <<table student_modules>> {
  <<PK,FK>> student_id : Int
  <<PK,FK>> module_id : Int
}
class ExamBooking <<table exam_bookings>> {
  <<PK>> id : Int
  <<FK>> module_id : Int
  <<FK>> venue_id : Int
  exam_date : Date
  {field} slot : Char(5)
  {field} booked_by : VarChar(255) [0..1]
}
class SeatReservation <<table seat_reservations>> {
  <<PK,FK>> booking_id : Int
  <<PK,FK>> student_id : Int
  venue_id : Int
  exam_date : Date
  {field} slot : Char(5)
  seat_number : Int
}
class EmailOutbox <<table email_outbox>> {
  <<PK>> id : Int
  <<FK>> student_id : Int [0..1]
  {field} kind : VarChar(20)
  {field} to_email : VarChar(255)
  {field} subject : VarChar(255)
  {field} status : VarChar(20) = "queued"
}
class User <<table users>> {
  <<PK>> id : Int
  {field} email : VarChar(255) {unique}
  {field} name : VarChar(100)
  password_hash : Text
  {field} role : VarChar(20) = "invigilator"
  active : Boolean = true
  must_change_password : Boolean
}
Venue "1" -- "0..*" Device : hosts >
Device "0..1" -- "0..*" Student : enrols >
Device "1" -- "0..*" AccessEvent : reports >
Student "0..1" -- "0..*" AccessEvent : recognised in >
AccessEvent "1" *-- "0..*" EventOverride : overridden by >
Student "1" *-- "0..*" StudentModule
Module "1" *-- "0..*" StudentModule
Module "1" *-- "0..*" ExamBooking : examined in >
Venue "1" -- "0..*" ExamBooking : held in <
ExamBooking "1" *-- "0..*" SeatReservation : seats >
Student "1" *-- "0..*" SeatReservation : sits >
Student "0..1" -- "0..*" EmailOutbox : receives >
note bottom of SeatReservation
  {unique} (student_id, exam_date, slot)
  {unique} (venue_id, exam_date, slot, seat_number)
end note
note bottom of AccessEvent
  decision in {granted, denied, error,
  already, ended, signed_out}
  {unique} (device_id, client_event_id)
end note
@enduml
