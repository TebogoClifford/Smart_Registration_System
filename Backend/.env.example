# Copy to .env for local use. On Render, set these under Environment instead. Never commit a real .env.

# --- required ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# PGSSL=disable            # only for a local Postgres without TLS

# --- sign-in (REQUIRED: the server will not start without JWT_SECRET; AUTH_DISABLED=true is for local tests only) ---
JWT_SECRET=                # 32+ random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=               # first administrator, created only when the users table is empty
ADMIN_PASSWORD=            # 8+ characters; change it after first sign-in
TOKEN_HOURS=12             # how long a sign-in lasts

# --- security ---
CORS_ORIGIN=               # comma-separated website addresses allowed to call the API, e.g. https://your-app.vercel.app

# --- device tuning (all optional) ---
DEVICE_CAPTURE_DISTANCE_CM=30
DEVICE_HEARTBEAT_SECONDS=30
DEVICE_ENROLL_POLL_SECONDS=3
ENROLL_REQUEST_TTL_SECONDS=600   # an enrollment request nobody collected expires after this
HEARTBEAT_TIMEOUT_SECONDS=120    # device shows "inactive" after this long without contact

# --- exams ---
EXAM_TIMEZONE=Africa/Johannesburg   # before 12:00 here the 09:00 session is current, from 12:00 the 13:00 one

# PORT is set by Render itself.
